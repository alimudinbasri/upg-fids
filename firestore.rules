rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isHardcodedAdmin() {
      return request.auth != null && request.auth.token.email in [
        'alimudinbasri@gmail.com',
        'alimudin.basri@injourneyairports.id',
        'upg.pl@injourneyairports.id'
      ];
    }

    // isAdmin: hardcoded admin OR dynamic admin (UID stored in admin_uids)
    function isAdmin() {
      return isHardcodedAdmin() ||
        (request.auth != null &&
         exists(/databases/$(database)/documents/admin_uids/$(request.auth.uid)));
    }

    // Activity logs
    match /activity_logs/{logId} {
      allow create: if request.auth != null;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Presence — user boleh tulis/hapus miliknya sendiri; admin boleh hapus siapapun
    match /presence/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    // Blocked users — semua user login boleh cek status blokir dirinya;
    // hanya admin yang boleh list semua dan boleh tulis/hapus
    match /blocked_users/{emailKey} {
      allow get:         if request.auth != null;
      allow list, write: if isAdmin();
    }

    // Admins collection
    match /admins/{emailKey} {
      allow read:  if request.auth != null;
      allow write: if isHardcodedAdmin();
    }

    // Admin UIDs — diisi saat dynamic admin login ke admin.html;
    // digunakan oleh Firestore rules untuk cek isAdmin() via exists()
    match /admin_uids/{uid} {
      allow read: if request.auth != null;
      allow write: if isHardcodedAdmin() || (request.auth != null && request.auth.uid == uid);
      allow delete: if isHardcodedAdmin();
    }

    // User login records
    match /user_logs/{emailKey} {
      allow write: if request.auth != null;
      allow list, get: if request.auth != null;
    }

    // WA Report settings (opening/closing text per page) — shared config,
    // any logged-in user may view/edit (matches current app behavior: no isAdmin gate in JS)
    match /wa_settings/{pageId} {
      allow read, write: if request.auth != null;
    }
  }
}
