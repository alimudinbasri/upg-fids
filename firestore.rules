rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isHardcodedAdmin() {
      return request.auth != null && request.auth.token.email in [
        'alimudinbasri@gmail.com',
        'alimudin.basri@injourneyairports.id',
        'upg.pl@injourneyairports.id'
      ];
    }

    // Mirrors emailToKey() in js/auth-guard.js and admin.html
    function emailToKey(email) {
      return email.lower().replace('\\.', '_').replace('@', '__');
    }

    // Dynamic admin: email has a doc in /admins (only isHardcodedAdmin() can write there)
    function isDynamicAdminByEmail() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(emailToKey(request.auth.token.email)));
    }

    // isAdmin: hardcoded admin OR dynamic admin, verified against /admins (source of truth).
    // Does NOT trust /admin_uids directly — that collection is self-writable by uid owners,
    // so using its mere existence as the admin check would let any logged-in user grant
    // themselves admin by writing their own admin_uids/{uid} doc from the browser console.
    function isAdmin() {
      return isHardcodedAdmin() || isDynamicAdminByEmail();
    }

    // Activity logs — create must be self-attributed (uid/email match the caller),
    // so a user can't forge a log entry claiming to be someone else
    match /activity_logs/{logId} {
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == request.auth.token.email;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Presence — user boleh tulis/hapus miliknya sendiri; admin boleh hapus siapapun
    match /presence/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    // Blocked users — semua user login boleh cek status blokir dirinya;
    // hanya admin yang boleh list semua dan boleh tulis/hapus
    match /blocked_users/{emailKey} {
      allow get:         if request.auth != null;
      allow list, write: if isAdmin();
    }

    // Admins collection
    match /admins/{emailKey} {
      allow read:  if request.auth != null;
      allow write: if isHardcodedAdmin();
    }

    // Admin UIDs — bookkeeping cache written by admin.html on login; NOT used by isAdmin()
    // (see note above). Self-write only allowed once the caller is already a verified
    // admin via /admins, so this can no longer be used to self-escalate.
    match /admin_uids/{uid} {
      allow read: if request.auth != null;
      allow write: if isHardcodedAdmin() ||
        (request.auth != null && request.auth.uid == uid && isDynamicAdminByEmail());
      allow delete: if isHardcodedAdmin();
    }

    // User login records — a user may only write their own record
    // (doc id must be their own emailKey, and uid must match)
    match /user_logs/{emailKey} {
      allow write: if request.auth != null &&
        emailKey == emailToKey(request.auth.token.email) &&
        request.resource.data.uid == request.auth.uid;
      allow list, get: if request.auth != null;
    }

    // WA Report settings (opening/closing text per page) — shared config,
    // read by any logged-in user (needed to generate the WA report), but
    // only admins may edit it since it's shared across all users of a page.
    match /wa_settings/{pageId} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    // Flight data cache, kept fresh by a Google Apps Script time-driven trigger
    // signed in as a dedicated sync account. Only that account may write, so a
    // compromised/regular user session can never inject false flight data here.
    match /flights_cache/{date} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.token.email == 'gas-sync@upg-fids.internal';
    }

    // Sync heartbeat, written by the same Apps Script account on every run.
    // Deliberately a separate, tiny document rather than a field on
    // flights_cache: the data documents are ~55KB each, and any write to one
    // pushes the whole thing to every client holding an onSnapshot listener.
    // Keeping the "is the sync alive?" signal here means a heartbeat costs
    // nothing, which in turn lets the sync skip rewriting unchanged flight data.
    //   sync_status/heartbeat.lastRun   -> is the sync still running
    //   flights_cache/{date}.updatedAt  -> when the data last actually changed
    match /sync_status/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.token.email == 'gas-sync@upg-fids.internal';
    }

    // Site-wide maintenance mode toggle. Public read (auth-guard.js must be able
    // to check this before a user is even logged in, so it can redirect straight
    // to maintenance.html); only admins can flip it.
    match /site_config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
