{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "apps-script/**",
      "tests/**",
      "**/.*",
      ".git/**",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/favicon.ico",
        "destination": "/icon.svg",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
